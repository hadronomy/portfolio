{
  "name": "@portfolio/astro",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro preview",
    "shaders:check": "vgpu check src/shaders/inari.wgsl --require-validation && vgpu check src/shaders/ram.wgsl --require-validation && vgpu check src/shaders/routes.wgsl --require-validation",
    "covers:render": "node scripts/shaders/render-covers.mjs",
    "build": "astro check && astro build && node scripts/seo/check.mjs",
    "seo:check": "node scripts/seo/check.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:routing": "vitest run tests/start-routing.test.mjs",
    "test:dev": "vitest run tests/start-dev.test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "catalog:prod",
    "@astrojs/mdx": "catalog:prod",
    "@astrojs/react": "catalog:prod",
    "@astrojs/rss": "catalog:prod",
    "@astrojs/sitemap": "catalog:prod",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/logos": "catalog:icons",
    "@iconify-json/material-icon-theme": "catalog:icons",
    "@iconify-json/simple-icons": "catalog:icons",
    "@iconify-json/tabler": "catalog:icons",
    "@nanostores/persistent": "1.3.5",
    "@portfolio/tailwind-config": "workspace:",
    "astro": "catalog:prod",
    "astro-icon": "catalog:icons",
    "fumadocs-core": "catalog:prod",
    "fumadocs-ui": "catalog:prod",
    "katex": "catalog:prod",
    "motion": "catalog:prod",
    "nanostores": "1.4.2",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "rehype-accessible-emojis": "catalog:prod",
    "rehype-katex": "catalog:prod",
    "remark-gemoji": "catalog:prod",
    "remark-math": "catalog:prod",
    "sharp": "catalog:prod",
    "sharp-ico": "catalog:prod",
    "tailwindcss": "catalog:style",
    "takumi-pdf": "catalog:prod",
    "takumi-js": "catalog:prod",
    "vgpu": "catalog:prod",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/node": "11.1.5",
    "@astrojs/vercel": "11.0.10",
    "@atproto/oauth-client-node": "0.5.9",
    "@electric-sql/pglite": "0.5.8",
    "@embedpdf/engines": "2.15.0",
    "@embedpdf/pdfium": "2.15.0",
    "@portfolio/site-routing": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@astrojs/language-server": "catalog:dev",
    "@shikijs/twoslash": "catalog:syntax",
    "@tailwindcss/vite": "catalog:build",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vercel/routing-utils": "6.5.0",
    "@vgpu/wgsl": "catalog:prod",
    "@webgpu/types": "catalog:types",
    "prettier": "catalog:lint",
    "prettier-plugin-astro": "catalog:lint",
    "rollup-preserve-directives": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  }
}
