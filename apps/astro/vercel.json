{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hadronomy.com"
        }
      ],
      "destination": "https://hadronomy.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*/|)",
      "has": [
        {
          "type": "host",
          "value": "www.hadronomy.com"
        }
      ],
      "destination": "https://hadronomy.com/:path",
      "permanent": true
    },
    {
      "source": "/work/stacks/",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/:path((?!(?:invoices|_apps|\\.well-known)(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
