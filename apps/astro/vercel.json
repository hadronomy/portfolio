{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work/stacks/",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/:path((?!(?:invoices|_apps|\\.well-known)(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "www.hadronomy.com"
        }
      ],
      "destination": "https://hadronomy.com/:path*",
      "permanent": true
    }
  ],
  "regions": ["fra1"]
}
