{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/work/stacks/",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hadronomy.com" }],
      "destination": "https://hadronomy.com/:path*",
      "permanent": true
    }
  ]
}
