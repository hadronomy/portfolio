---
import Shortcut from '~/components/core/Shortcut.astro';
import CoreLayout from '~/layouts/Core.astro';
---

<CoreLayout
  title="Not found | Pablo Hernández"
  description="That page does not exist."
>
  {/*
    Core gives this page a 76vh block and centres one line in it. The header and
    signature stay, so a visitor who lands here still sees a working site rather
    than an error screen — hence no back link and no chrome of its own.
  */}
  <section
    class="flex h-[76vh] w-full flex-col items-center justify-center gap-4 px-4"
  >
    <p class="type-body-sm text-muted-foreground select-none" aria-hidden="true">
      ¯\_(ツ)_/¯
    </p>

    <p class="type-body flex flex-wrap items-center justify-center gap-1.5 text-center text-muted-foreground">
      Go back <a
        href="/"
        class="font-medium text-foreground underline decoration-muted-foreground/50 underline-offset-[3px] transition-[text-decoration-color] hover:decoration-current"
        >home</a
      > or press <Shortcut key="H" />
    </p>
  </section>
</CoreLayout>

<script is:inline>
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'h' && event.key !== 'H') return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;

    // Same guards as the copy shortcut: never steal a keystroke from a field,
    // and never fire while the visitor is selecting text.
    const el = document.activeElement;
    if (
      el instanceof HTMLElement &&
      (el.isContentEditable || /^(input|textarea|select)$/i.test(el.tagName))
    ) {
      return;
    }
    if (window.getSelection()?.toString()) return;

    window.location.href = '/';
  });
</script>
