---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import WritingList from '~/components/core/WritingList.astro';
import CoreLayout from '~/layouts/Core.astro';
import { getPosts } from '~/lib/posts';

const posts = await getPosts();
---

<CoreLayout
  title="Writing | Pablo Hernández"
  description="Notes on the things I build and the things that break."
  back="/"
>
  {/*
    Core has no index page for its writing route — the list lives on the home
    page and under each post. This is the same list given a page of its own, so
    the kicker row and the rows below it are the components that already exist.
  */}
  <Section gap={24}>
    <div class="flex items-baseline justify-between gap-4">
      <Overline>Writing</Overline>
      {/* One expression, not two either side of a space — Astro drops the
          literal whitespace between them. */}
      <Overline>
        {`${posts.length} ${posts.length === 1 ? 'note' : 'notes'}`}
      </Overline>
    </div>

    <h1 class="type-h1 text-foreground">
      Notes on the things I build, and the things that break.
    </h1>
  </Section>

  {
    posts.length > 0 ? (
      <WritingList {posts} />
    ) : (
      <Section>
        <p class="type-body text-muted-foreground">
          Nothing published yet. The feed is live, so it will show up there
          first.
        </p>
      </Section>
    )
  }
</CoreLayout>
