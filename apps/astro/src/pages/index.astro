---
import Contact from '~/components/core/Contact.astro';
import Experience from '~/components/core/Experience.astro';
import Intro from '~/components/core/Intro.astro';
import Stack from '~/components/core/Stack.astro';
import Work from '~/components/core/Work.astro';
import Writing from '~/components/core/Writing.astro';
import Layout from '~/layouts/Layout.astro';
import { pageUrl, person, website } from '~/lib/seo';
import { SITE_DESCRIPTION } from '~/consts';
---

<Layout
  printCV
  structuredData={[
    website,
    person,
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl('/')}#profile`,
      url: pageUrl('/'),
      name: person.name,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      isPartOf: { '@id': website['@id'] },
      mainEntity: { '@id': person['@id'] },
    },
  ]}
>
  <Intro />
  <Work />
  <Experience />
  <Stack />
  <Writing />
  <Contact />
</Layout>
