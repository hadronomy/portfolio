---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="Experiments | Pablo Hernández" description="Small apps, utilities, and experiments.">
  <section class="mx-auto w-full max-w-[var(--content-width)] px-4 py-16">
    <h1 class="type-heading mb-4">Experiments</h1>
    <p class="type-body text-muted-foreground mb-8">Small tools and things I want to try.</p>
    <a href="/experiments/text" data-astro-reload class="type-body underline underline-offset-4"
      >Text tools ↗</a
    >
    <p class="type-body-sm text-muted-foreground mt-2">
      Count text and calculate a SHA-256 fingerprint.
    </p>
  </section>
</Layout>
