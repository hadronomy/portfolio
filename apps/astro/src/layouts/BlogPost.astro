---
import { Icon } from 'astro-icon/components';
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import WritingList from '~/components/core/WritingList.astro';
import CoreLayout from '~/layouts/Core.astro';
import {
  getPosts,
  longDate,
  type Post,
  readingMinutes,
  wordCount,
} from '~/lib/posts';

// KaTeX, twoslash and the article styles load with this layout rather than
// globally, so no other page pays for them.
import 'katex/dist/katex.min.css';
import '~/styles/article.css';
import '~/styles/twoslash.css';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, state } = post.data;

const words = wordCount(post.body);

const more = (await getPosts())
  .filter((entry) => entry.id !== post.id)
  .slice(0, 4);
---

<CoreLayout
  {title}
  {description}
  back="/blog"
  type="article"
  image={heroImage.src}
  publishedTime={pubDate.toISOString()}
>
  {/*
    Core sets 24px between the metadata row, the title and the body, on a 640px
    column with 16px of gutter. Read off the canvas, not measured.
  */}
  <article>
    <Section gap={24}>
      <div class="flex items-center gap-2.5">
        <p class="type-overline flex-1 text-muted-foreground">
          <time datetime={pubDate.toISOString()}>{longDate.format(pubDate)}</time
          >
          {
            state === 'draft' && (
              <span class="ml-2 text-foreground">· Draft</span>
            )
          }
        </p>

        <div
          class="type-overline flex shrink-0 items-center gap-3 text-muted-foreground"
        >
          <span class="flex items-center gap-1.5">
            <Icon name="tabler:clock" class="size-4" />
            {readingMinutes(post.body)} m
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="tabler:align-left" class="size-4" />
            {words} words
          </span>
        </div>
      </div>

      <h1 class="type-h1 text-foreground">{title}</h1>

      <div class="article">
        <slot />
      </div>
    </Section>
  </article>

  {
    more.length > 0 && (
      <div class="flex w-full flex-col gap-4">
        <Section>
          <Overline class="opacity-70">More</Overline>
        </Section>

        <WritingList posts={more} />
      </div>
    )
  }

</CoreLayout>
