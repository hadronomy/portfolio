---
import CopyShortcut from '~/components/core/CopyShortcut.astro';
import Header from '~/components/core/Header.astro';
import ScrollBlur from '~/components/core/ScrollBlur.astro';
import Signature from '~/components/core/Signature.astro';
import Metadata from '~/components/Metadata.astro';
import Cursor from '~/components/react/Cursor';
import { SITE_DESCRIPTION, SITE_TITLE } from '~/consts';

interface Props {
  title?: string;
  description?: string;
  /** Renders the header as a back link to this path instead of the clock row. */
  back?: string;
  /** Social card image. Defaults to the site-wide one inside Metadata. */
  image?: string;
  publishedTime?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  back,
  image,
  publishedTime,
  type,
} = Astro.props;
---

<html lang="en" class="antialiased">
  <head>
    <Metadata {title} {description} {image} {publishedTime} {type} />
  </head>

  <body
    class="min-h-screen bg-background font-sans text-foreground selection:bg-foreground selection:text-background"
  >
    {/* One centred column, no chrome — navigation lives in the page itself
        rather than in a bar. */}
    <Header {back} />

    <main class="flex w-full flex-col gap-10 pb-8">
      <slot />
    </main>

    <Signature />

    <ScrollBlur edge="top" />
    <ScrollBlur edge="bottom" />

    <CopyShortcut />

    {/*
      Decorative, so it waits for an idle moment rather than blocking the first
      paint on react + motion.

      Persisted across navigations. Without it the island is inside the body
      being swapped, so it unmounts — taking the follower out of the document
      and running the cleanup that gives the system cursor back — and a fresh
      one mounts needing two render passes to undo both. That gap is a frame of
      no custom cursor and a frame of the real one. Persisting also keeps the
      follower's position, so it does not re-enter from wherever it last was.
    */}
    <Cursor client:idle transition:persist />
  </body>
</html>
