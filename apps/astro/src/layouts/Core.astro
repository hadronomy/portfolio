---
import CopyShortcut from '~/components/core/CopyShortcut.astro';
import Header from '~/components/core/Header.astro';
import ScrollBlur from '~/components/core/ScrollBlur.astro';
import Signature from '~/components/core/Signature.astro';
import Metadata from '~/components/Metadata.astro';
import Cursor from '~/components/react/Cursor';
import { SITE_DESCRIPTION, SITE_TITLE } from '~/consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<html lang="en" class="antialiased">
  <head>
    <Metadata title={title} description={description} />
  </head>

  <body
    class="min-h-screen bg-background font-sans text-foreground selection:bg-foreground selection:text-background"
  >
    {/* One centred column, no chrome — Core carries navigation in the page
        itself rather than in a bar. */}
    <Header />

    {/* 40px between sections, measured off the reference render — the canvas
        reports a zero gap here and puts the spacing somewhere it does not
        expose, so this comes from the pixels rather than the API. */}
    <main class="flex w-full flex-col gap-10 pb-8">
      <slot />
    </main>

    <Signature />

    <ScrollBlur edge="top" />
    <ScrollBlur edge="bottom" />

    <CopyShortcut />

    {/* Decorative, so it waits for an idle moment rather than blocking the
        first paint on react + motion. */}
    <Cursor client:idle />
  </body>
</html>
