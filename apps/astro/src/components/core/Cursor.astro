---
/*
  A soft follower that trails the pointer and morphs over anything carrying a
  `data-cursor` attribute. Ported from Core's Elements/Cursor: a 20px dot at
  16px radius in the translucent cursor token, a preview card at 10px radius
  with 2px padding around 104px-tall media, and a label pill with a 10px
  activity dot.

  The native cursor stays visible. Core's fill is 15%/30% alpha, which reads as
  something travelling *with* the pointer rather than replacing it — and hiding
  the real cursor to substitute a div is a bet against every accessibility
  setting the visitor might rely on.
*/
---

<div
  id="cursor"
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-[60] hidden"
>
  <div
    id="cursor-shape"
    class="flex origin-top-left items-center overflow-hidden bg-cursor backdrop-blur-[2px]"
  >
    {/* Media and label both live in the DOM so a morph never waits on a fetch;
        the image is only fetched once a link declares it. */}
    <img
      id="cursor-media"
      alt=""
      width="168"
      height="104"
      class="hidden h-[104px] w-[168px] rounded-[8px] object-cover"
    />

    <span
      id="cursor-label"
      class="type-body-xs hidden items-center gap-2 px-2.5 py-1 whitespace-nowrap text-foreground"
    >
      <span
        id="cursor-dot"
        class="hidden size-2.5 shrink-0 rounded-pill bg-[rgb(22,191,94)]"></span>
      <span id="cursor-text"></span>
    </span>
  </div>
</div>

<style>
  #cursor-shape {
    width: 20px;
    height: 20px;
    border-radius: 16px;
    padding: 0;
    transition:
      width 260ms cubic-bezier(0.22, 1, 0.36, 1),
      height 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 260ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Core's Link Preview variant: fit-content at 2px padding, 10px radius. */
  #cursor[data-state='preview'] #cursor-shape {
    width: 172px;
    height: 108px;
    border-radius: 10px;
    padding: 2px;
  }

  #cursor[data-state='label'] #cursor-shape {
    width: var(--cursor-label-width, 120px);
    height: 28px;
    border-radius: 999px;
  }

  #cursor[data-state='preview'] #cursor-media,
  #cursor[data-state='label'] #cursor-label {
    display: flex;
  }

  /* A pointing device that can hover, and a visitor who wants motion. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    #cursor.is-ready {
      display: block;
      opacity: 1;
      transition: opacity 160ms ease-out;
    }

    #cursor.is-ready[data-away] {
      opacity: 0;
    }
  }
</style>

<script>
  type State = 'dot' | 'preview' | 'label';

  const FOLLOW = 0.18;

  const root = document.getElementById('cursor');
  const shape = document.getElementById('cursor-shape');
  const media = document.getElementById('cursor-media') as HTMLImageElement | null;
  const label = document.getElementById('cursor-label');
  const dot = document.getElementById('cursor-dot');
  const text = document.getElementById('cursor-text');

  const enabled =
    root &&
    shape &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (enabled) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let seen = false;
    let frame = 0;
    let state: State = 'dot';

    // The shape grows from its own top-left, so the offset that keeps it
    // centred on the pointer changes as it morphs.
    const offset = () => {
      const rect = shape.getBoundingClientRect();
      return state === 'dot'
        ? { dx: rect.width / 2, dy: rect.height / 2 }
        : { dx: 18, dy: 18 };
    };

    const render = () => {
      frame = 0;
      x += (targetX - x) * FOLLOW;
      y += (targetY - y) * FOLLOW;

      const { dx, dy } = offset();
      root.style.transform = `translate3d(${Math.round(x - dx)}px, ${Math.round(y - dy)}px, 0)`;

      if (Math.abs(targetX - x) > 0.1 || Math.abs(targetY - y) > 0.1) schedule();
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    const setState = (next: State) => {
      if (next === state) return;
      state = next;
      root.dataset.state = next === 'dot' ? '' : next;
      schedule();
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;

        targetX = event.clientX;
        targetY = event.clientY;

        if (!seen) {
          // Land on the pointer instead of flying in from the corner.
          seen = true;
          x = targetX;
          y = targetY;
          root.classList.add('is-ready');
        }

        schedule();
      },
      { passive: true },
    );

    document.addEventListener('pointerover', (event) => {
      const target = (event.target as Element | null)?.closest?.('[data-cursor]');

      if (!target) {
        setState('dot');
        return;
      }

      const kind = target.getAttribute('data-cursor');

      if (kind === 'preview' && media) {
        const src = target.getAttribute('data-cursor-src');
        if (!src) return setState('dot');
        if (media.getAttribute('src') !== src) media.setAttribute('src', src);
        setState('preview');
        return;
      }

      if (kind === 'label' && label && text) {
        text.textContent = target.getAttribute('data-cursor-label') ?? '';
        dot?.classList.toggle(
          'hidden',
          !target.hasAttribute('data-cursor-active'),
        );
        // Measure once so the pill can animate to a real width.
        root.style.setProperty('--cursor-label-width', 'auto');
        const width = label.getBoundingClientRect().width;
        root.style.setProperty('--cursor-label-width', `${Math.ceil(width)}px`);
        setState('label');
        return;
      }

      setState('dot');
    });

    // Leaving the window fades the follower out but keeps its last position, so
    // coming back does not send it flying in from wherever it was parked.
    document.addEventListener('pointerleave', () => {
      root.dataset.away = '';
    });

    document.addEventListener('pointerenter', () => {
      delete root.dataset.away;
    });
  }
</script>
