---
/*
  A follower that trails the pointer and morphs over anything carrying a
  `data-cursor` attribute. Ported from Core's Elements/Cursor, with the timing
  read off a screen recording frame by frame rather than guessed.

  What the recording shows, at 60fps:

  - The card grows from small to full over 8-9 frames, so roughly 140ms.
  - It starts heavily blurred and sharpens as it grows. The soft edges during
    the morph are the element's own `filter`, not a backdrop effect.
  - There is no overshoot; it settles straight into place.
  - What reads as a border is the 2px padding ring showing the background
    through, measured at rgba(255,255,255,0.29) over an 11-value backdrop,
    which is the cursor token itself.
  - The card centres on the pointer rather than hanging off one corner.

  The native cursor stays. Core fills its dot at 15%/30% alpha, which reads as
  something travelling with the pointer rather than replacing it, and swapping
  a div for the real cursor bets against every pointer setting a visitor might
  depend on.
*/
---

<div
  id="cursor"
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-[60] hidden"
>
  <div id="cursor-shape" class="flex items-center overflow-hidden bg-cursor">
    {/* Sized to the box rather than fixed, so it grows with the card instead
        of popping in at full size once the morph finishes. */}
    <img
      id="cursor-media"
      alt=""
      class="h-full w-full rounded-[8px] object-cover opacity-0"
    />

    <span
      id="cursor-label"
      class="type-body-xs hidden items-center gap-2 px-2.5 py-1 whitespace-nowrap text-foreground"
    >
      <span
        id="cursor-dot"
        class="hidden size-2.5 shrink-0 rounded-pill bg-[rgb(22,191,94)]"></span>
      <span id="cursor-text"></span>
    </span>
  </div>
</div>

<style>
  #cursor-shape {
    width: 20px;
    height: 20px;
    border-radius: 16px;
    padding: 0;
    /* 140ms measured; the ease-out is what stops it reading as a snap. */
    transition:
      width 150ms cubic-bezier(0.22, 1, 0.36, 1),
      height 150ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 150ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #cursor-media {
    transition: opacity 150ms ease-out;
  }

  /* Core's Link Preview variant: 2px padding, 10px radius, 104px of media. */
  #cursor[data-state='preview'] #cursor-shape {
    width: 172px;
    height: 108px;
    border-radius: 10px;
    padding: 2px;
  }

  #cursor[data-state='label'] #cursor-shape {
    width: var(--cursor-label-width, 120px);
    height: 28px;
    border-radius: 999px;
  }

  #cursor[data-state='preview'] #cursor-media {
    opacity: 1;
  }

  #cursor[data-state='label'] #cursor-label {
    display: flex;
  }

  /* Blurred at the start of a morph, sharp by the end. Runs on entering either
     expanded state, which is why it lives on the state selector rather than in
     the transition above — a transition cannot start from a value the resting
     state never holds. */
  #cursor[data-state='preview'] #cursor-shape,
  #cursor[data-state='label'] #cursor-shape {
    animation: cursor-morph 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes cursor-morph {
    from {
      filter: blur(8px);
    }
    to {
      filter: blur(0);
    }
  }

  /* A pointing device that can hover, and a visitor who wants motion. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    #cursor.is-ready {
      display: block;
      opacity: 1;
      transition: opacity 160ms ease-out;
    }

    #cursor.is-ready[data-away] {
      opacity: 0;
    }
  }
</style>

<script>
  type State = 'dot' | 'preview' | 'label';

  /*
    Tight enough to read as the pointer's own, loose enough to smooth the jitter
    of a real hand. At 60fps this closes ~97% of a gap in four frames.
  */
  const FOLLOW = 0.55;

  const root = document.getElementById('cursor');
  const shape = document.getElementById('cursor-shape');
  const media = document.getElementById('cursor-media') as HTMLImageElement | null;
  const label = document.getElementById('cursor-label');
  const dot = document.getElementById('cursor-dot');
  const text = document.getElementById('cursor-text');

  const enabled =
    root &&
    shape &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (enabled) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let seen = false;
    let frame = 0;
    let state: State = 'dot';

    const render = () => {
      frame = 0;
      x += (targetX - x) * FOLLOW;
      y += (targetY - y) * FOLLOW;

      // Centred on the pointer in every state, so the morph grows outward
      // rather than dragging one corner across the screen.
      const rect = shape.getBoundingClientRect();
      const left = Math.round(x - rect.width / 2);
      const top = Math.round(y - rect.height / 2);
      root.style.transform = `translate3d(${left}px, ${top}px, 0)`;

      if (Math.abs(targetX - x) > 0.1 || Math.abs(targetY - y) > 0.1) schedule();
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    // The box keeps changing for the length of the morph, so keep re-centring
    // through it rather than only while the pointer is moving.
    const trackMorph = () => {
      let elapsed = 0;
      const step = () => {
        elapsed += 16;
        render();
        if (elapsed < 200) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const setState = (next: State) => {
      if (next === state) return;
      state = next;
      root.dataset.state = next === 'dot' ? '' : next;
      trackMorph();
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;

        targetX = event.clientX;
        targetY = event.clientY;

        if (!seen) {
          // Land on the pointer instead of flying in from the corner.
          seen = true;
          x = targetX;
          y = targetY;
          root.classList.add('is-ready');
        }

        schedule();
      },
      { passive: true },
    );

    document.addEventListener('pointerover', (event) => {
      const target = (event.target as Element | null)?.closest?.('[data-cursor]');

      if (!target) return setState('dot');

      const kind = target.getAttribute('data-cursor');

      if (kind === 'preview' && media) {
        const src = target.getAttribute('data-cursor-src');
        if (!src) return setState('dot');
        if (media.getAttribute('src') !== src) media.setAttribute('src', src);
        return setState('preview');
      }

      if (kind === 'label' && label && text) {
        text.textContent = target.getAttribute('data-cursor-label') ?? '';
        dot?.classList.toggle(
          'hidden',
          !target.hasAttribute('data-cursor-active'),
        );
        // Measure once so the pill animates to a real width.
        root.style.setProperty('--cursor-label-width', 'auto');
        const width = label.getBoundingClientRect().width;
        root.style.setProperty('--cursor-label-width', `${Math.ceil(width)}px`);
        return setState('label');
      }

      setState('dot');
    });

    // Leaving the window fades the follower but keeps its position, so coming
    // back does not send it flying in from wherever it was parked.
    document.addEventListener('pointerleave', () => {
      root.dataset.away = '';
    });

    document.addEventListener('pointerenter', () => {
      delete root.dataset.away;
    });
  }
</script>
