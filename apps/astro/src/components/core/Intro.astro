---
import { Icon } from 'astro-icon/components';
import Section from '~/components/core/Section.astro';
import Shortcut from '~/components/core/Shortcut.astro';
import PresencePrototype from '~/components/react/prototype/PresencePrototype';
import { profile } from '~/lib/profile';
---

<Section id="intro" gap={24}>
  <div class="flex items-center gap-4">
    <div class="relative shrink-0">
      <img
        src={profile.avatar}
        alt=""
        width="56"
        height="56"
        class="size-14 rounded-[12px] object-cover"
        loading="eager"
      />
      {/*
        The ring is drawn in the page background rather than white so the dot
        reads as punched out of the avatar in both themes.
      */}
      <span
        id="presence-static"
        class="absolute -right-0.5 -bottom-0.5 size-3 rounded-pill bg-[rgb(22,191,94)] ring-2 ring-background"
        aria-hidden="true"></span>

      {/* PROTOTYPE — remove with src/components/react/prototype once a
          variant wins. Gated here rather than inside the component so the
          island is never emitted at all: returning null from the component
          still ships a hydration stub and a chunk. */}
      {import.meta.env.DEV && <PresencePrototype client:idle />}
    </div>

    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <h1 class="type-h3 text-foreground">{profile.name}</h1>
        {/* A sweep stands in for animating the badge between two variants,
            the same idea done in one element. */}
        <span class="badge relative inline-flex size-5 shrink-0">
          <Icon
            name="tabler:rosette-discount-check-filled"
            class="size-5 text-[rgb(29,155,240)]"
            aria-hidden="true"
          />
        </span>
      </div>
      <p class="type-body text-muted-foreground">{profile.role}</p>
    </div>
  </div>

  <p class="type-body max-w-measure text-muted-foreground">
    {profile.intro}
  </p>

  <p class="type-body flex flex-wrap items-center gap-1.5 text-muted-foreground">
    Press <Shortcut key="C" /> to copy my email
  </p>
</Section>

<style>
  /* A highlight travelling across the mark, masked to the badge itself so it
     never leaks a rectangle over the name beside it. */
  .badge::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: linear-gradient(
      110deg,
      transparent 40%,
      rgb(255 255 255 / 0.75) 50%,
      transparent 60%
    );
    background-size: 300% 100%;
    animation: badge-sweep 4.5s ease-in-out infinite;
    mix-blend-mode: overlay;
  }

  @keyframes badge-sweep {
    0%,
    65% {
      background-position: 150% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
