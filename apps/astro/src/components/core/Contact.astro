---
import { Icon } from 'astro-icon/components';
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import { socials } from '~/lib/profile';
---

<Section id="contact" gap={16}>
  <Overline>Contact</Overline>

  <p class="type-body text-muted-foreground">
    The fastest way to reach me is email. Everything else below reaches me too.
  </p>

  {/*
    Core puts a form here. This is a static site with no endpoint behind it, and
    a form that silently drops messages is worse than no form, so the rows are
    the whole contact surface until there is somewhere to post to.
  */}
  <ul class="flex flex-col">
    {
      socials.map((social) => (
        <li>
          <a
            href={social.href}
            class="group flex items-center gap-3 rounded-[var(--radius)] py-2.5 transition-colors hover:bg-button-hover"
            rel={social.href.startsWith('http') ? 'me noreferrer' : undefined}
            target={social.href.startsWith('http') ? '_blank' : undefined}
          >
            <Icon name={social.icon} class="size-4 shrink-0 text-foreground" />
            <span class="type-body text-foreground">{social.label}</span>

            <span class="type-body ml-auto flex items-center gap-1.5 text-muted-foreground">
              {social.handle}
              <Icon
                name="tabler:arrow-up-right"
                class="size-4 transition-transform group-hover:-translate-y-px group-hover:translate-x-px"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
