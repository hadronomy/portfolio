---
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Overline from '~/components/core/Overline.astro';
import Row from '~/components/core/Row.astro';
import Section from '~/components/core/Section.astro';
import Shortcut from '~/components/core/Shortcut.astro';
import { profile, socials } from '~/lib/profile';
import { languageNames, locales } from '~/i18n/locales';
---

{
  /*
  Heading, then the rows and the line that introduces them. The heading block
  stays capped to the column width; the rows are full width so their hover
  fill can bleed, which is why these are siblings rather than one wrapper.
*/
}
<div id="contact" class="flex w-full flex-col gap-8">
  <Section>
    <Overline>Contact</Overline>
  </Section>

  {
    /*
    Inline flow lets the text wrap around the keycap on narrow screens.
  */
  }
  <div class="flex w-full flex-col gap-4">
    <Section>
      <p class="type-body text-muted-foreground">
        <a href={`mailto:${profile.email}`} class="text-foreground underline underline-offset-4"
          >{profile.email}</a
        >
        {' · '}Press <Shortcut key="C" /> to copy it. These reach me too.
      </p>
    </Section>

    <ul class="flex w-full flex-col">
      {
        socials.map((social) => (
          <li>
            <Row href={social.href} external={social.href.startsWith('http')}>
              <Icon name={social.icon} class="size-5 shrink-0 text-foreground" />
              <span class:list={[social.markIsName ? 'sr-only' : 'type-body text-foreground']}>
                {social.label}
              </span>

              <span class="type-body ml-auto flex items-center gap-1.5 text-muted-foreground">
                {social.handle}
                <Icon
                  name="tabler:arrow-up-right"
                  class="size-4 transition-transform group-hover:-translate-y-px group-hover:translate-x-px"
                />
              </span>
            </Row>
          </li>
        ))
      }
    </ul>
  </div>
  <Section>
    <nav
      aria-label="Download curriculum vitae"
      class="type-body flex flex-wrap items-center gap-x-5 gap-y-2"
    >
      <span class="text-muted-foreground">CV</span>
      {
        locales.map((locale) => (
          <a
            href={`${getRelativeLocaleUrl(locale, '')}cv.pdf`}
            hreflang={locale}
            lang={locale}
            type="application/pdf"
            download={`Pablo_Hernandez-CV-${locale}.pdf`}
            class="text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
          >
            {languageNames[locale]} (PDF)
          </a>
        ))
      }
    </nav>
  </Section>
</div>
