---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import Sticker from '~/components/core/Sticker.astro';
import { stack } from '~/lib/profile';

/*
  TODO(later): this row shows ten of twenty-four. Redesign it to carry the
  full stack at the same density before adding entries here — widening this
  row is what makes it look like a checklist.
*/
---

<Section id="stack">
  <Overline>Stack</Overline>

  {/*
    The row is `space-between` across the full column with a gap as a
    minimum, not a packed left-aligned run — first mark flush left, last
    flush right. Wrapping is off there; on phones ten marks cannot fit that
    way, so wrapping comes back below the tablet breakpoint rather than
    overflowing.
  */}
  <ul
    class="flex flex-wrap items-center justify-start gap-2.5 tablet:flex-nowrap tablet:justify-between"
  >
    {
      stack.map((tool) => (
        <li class="group relative size-10 shrink-0">
          {/*
            Bare marks on a die-cut, no tile — the weight comes from each
            brand's artwork filling its box, not from a surface behind it.

            The cut is white rather than near-black: these marks don't each
            sit on their own background tile, so a near-black cut would
            vanish on the dark background. Cutting them white keeps every
            logo legible in both themes and gives the row one silhouette,
            which the raw glyphs do not have.

            The fold lifts the top-right corner. Angling it per sticker looked
            like variety on paper, but a crease that differs on every mark reads
            as noise at this size.

            The id is derived from the name rather than the loop index, because
            it keys where each sticker was left. An index would hand one
            sticker's position to another the first time this list is reordered.
          */}
          <Sticker
            icon={tool.icon}
            label={tool.name}
            uid={tool.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
          />

        </li>
      ))
    }
  </ul>
</Section>
