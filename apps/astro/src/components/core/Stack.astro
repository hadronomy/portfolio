---
import { Icon } from 'astro-icon/components';
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import { stack } from '~/lib/profile';

/*
  TODO(layer 5): this row shows ten of twenty-four. Redesign it to carry the
  full stack at the same density before adding entries here — widening this
  row is what makes it look like a checklist.
*/
---

<Section id="stack">
  <Overline>Stack</Overline>

  <ul class="flex flex-wrap items-center gap-2.5">
    {
      stack.map((tool) => (
        <li class="group relative">
          <span class="flex size-10 items-center justify-center rounded-[8px] text-foreground">
            <Icon name={tool.icon} class="size-6" aria-label={tool.name} />
          </span>

          {/*
            Core pairs each mark with a tooltip rather than a title attribute,
            which never appears on touch and cannot be styled. Rendered always
            and revealed on hover or keyboard focus, so it is never gated on JS.
          */}
          <span
            role="tooltip"
            class="type-body-xs pointer-events-none absolute bottom-full left-1/2 z-20 mb-1.5 -translate-x-1/2 rounded-[6px] bg-inset px-2 py-1 whitespace-nowrap text-foreground opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100"
          >
            {tool.name}
          </span>
        </li>
      ))
    }
  </ul>
</Section>
