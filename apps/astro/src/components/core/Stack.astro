---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import Sticker from '~/components/core/Sticker.astro';
import { stack } from '~/lib/profile';

/*
  TODO(later): this row shows ten of twenty-four. Redesign it to carry the
  full stack at the same density before adding entries here — widening this
  row is what makes it look like a checklist.
*/
---

<Section id="stack">
  <Overline>Stack</Overline>

  {/*
    Core's row is `space-between` across the full column with `gap: 10px` as a
    minimum, not a packed left-aligned run — first mark flush left, last flush
    right. Wrapping is off there; on phones ten 40px marks cannot fit that way,
    so wrapping comes back below the tablet breakpoint rather than overflowing.
  */}
  <ul
    class="flex flex-wrap items-center justify-start gap-2.5 tablet:flex-nowrap tablet:justify-between"
  >
    {
      stack.map((tool) => (
        <li class="group relative size-10 shrink-0">
          {/*
            Bare marks on a die-cut, no tile — Core's weight comes from each
            brand's artwork filling its 40px box, not from a surface behind it.

            The white cut is ours, not Core's: Core can afford near-black marks
            because every asset there sits on its own tile, and without tiles
            those marks vanish on the dark background. Cutting them keeps every
            logo legible in both themes and gives the row one silhouette, which
            the raw glyphs do not have.

            The fold lifts the top-right corner. Angling it per sticker looked
            like variety on paper, but a crease that differs on every mark reads
            as noise at this size.

            The id is derived from the name rather than the loop index, because
            it keys where each sticker was left. An index would hand one
            sticker's position to another the first time this list is reordered.
          */}
          <Sticker
            icon={tool.icon}
            label={tool.name}
            uid={tool.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
          />

          {/*
            Centred under the mark with a 15px gap, taken off the rendered
            reference — the canvas parks this node somewhere the live site
            never shows it.
          */}
          <span
            role="tooltip"
            class="type-body-xs pointer-events-none absolute top-[55px] left-1/2 z-20 -translate-x-1/2 rounded-[6px] bg-inset px-2 py-1 whitespace-nowrap text-foreground opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
          >
            {tool.name}
          </span>
        </li>
      ))
    }
  </ul>
</Section>
