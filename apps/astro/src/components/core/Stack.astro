---
import { Icon } from 'astro-icon/components';
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import { stack } from '~/lib/profile';

/*
  TODO(later): this row shows ten of twenty-four. Redesign it to carry the
  full stack at the same density before adding entries here — widening this
  row is what makes it look like a checklist.
*/
---

<Section id="stack">
  <Overline>Stack</Overline>

  {/* Core sets 10px between marks and leaves the row left-aligned. */}
  <ul class="flex flex-wrap items-center gap-2.5">
    {
      stack.map((tool) => (
        <li class="stack-item group relative size-10 shrink-0">
          {/*
            Bare marks, no tile — Core's weight comes from each brand's artwork
            filling its 40px box, not from a surface behind it.

            The white sticker outline is ours, not Core's: Core can afford
            near-black marks because every asset is drawn on its own tile, and
            without tiles those marks vanish on the dark background. Outlining
            them keeps every logo legible in both themes and gives the row a
            consistent silhouette, which the raw glyphs do not have.
          */}
          <span class="sticker flex size-10 items-center justify-center">
            <Icon name={tool.icon} class="size-9" aria-label={tool.name} />
          </span>

          {/*
            The tooltip sits directly below the mark and left-aligned to it,
            with a 15px gap — measured off the rendered reference rather than
            the canvas, where the node is parked somewhere else entirely.
          */}
          <span
            role="tooltip"
            class="type-body-xs pointer-events-none absolute top-[55px] left-0 z-20 rounded-[6px] bg-inset px-2 py-1 whitespace-nowrap text-foreground opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100 group-focus-within:opacity-100"
          >
            {tool.name}
          </span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /*
    A sticker cut-out: eight offset copies of the mark's own alpha shape in
    white, laid under it. Chained drop-shadows compound, so the radii stay
    small — anything larger reads as a blob rather than a die-cut edge.
  */
  .sticker {
    filter: drop-shadow(1.5px 0 0 #fff) drop-shadow(-1.5px 0 0 #fff)
      drop-shadow(0 1.5px 0 #fff) drop-shadow(0 -1.5px 0 #fff)
      drop-shadow(1.1px 1.1px 0 #fff) drop-shadow(-1.1px 1.1px 0 #fff)
      drop-shadow(1.1px -1.1px 0 #fff) drop-shadow(-1.1px -1.1px 0 #fff);
  }

  /* Grows a little, slowly. Scale comes off the reference at ~1.06; the long
     ease-out is what keeps it from feeling like a snap. */
  .stack-item {
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stack-item:hover,
  .stack-item:focus-within {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-item {
      transition: none;
    }

    .stack-item:hover,
    .stack-item:focus-within {
      transform: none;
    }
  }
</style>
