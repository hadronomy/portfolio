---
import { Icon } from 'astro-icon/components';
import Company from '~/components/core/Company.astro';
import Ull from '~/components/svg/Ull.astro';
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import { experience } from '~/lib/profile';
---

<Section id="experience" gap={32}>
  <div class="flex flex-col gap-4">
    <Overline>Experience</Overline>
    <p class="type-body text-muted-foreground">
      Ten years of building, most of it in the open. A brief overview.
    </p>
  </div>

  {
    experience.map((entry) => (
      /* The date column keeps titles aligned even for entries without dates. */
      <article class="grid gap-2 tablet:grid-cols-[8rem_minmax(0,1fr)] tablet:gap-x-4 tablet:gap-y-0">
        {entry.period && (
          <p class="type-overline pt-1 text-muted-foreground opacity-70">{entry.period}</p>
        )}

        <div class="flex flex-col gap-0.5 tablet:col-start-2 tablet:row-start-1">
          <h3 class="type-body flex flex-wrap items-center gap-1 font-medium text-foreground">
            <span>{entry.role}</span>
            {entry.organisation && (
              <>
                <span>at</span>
                <Company
                  name={entry.organisation.name}
                  url={entry.organisation.url}
                  preview={entry.organisation.preview}
                >
                  {entry.organisation.mark === 'ull' ? (
                    <Ull class="size-5 shrink-0 text-foreground" />
                  ) : (
                    <Icon name={entry.organisation.mark} class="size-5 shrink-0 text-foreground" />
                  )}
                </Company>
              </>
            )}
          </h3>
          <p class="type-body text-muted-foreground">{entry.description}</p>
        </div>
      </article>
    ))
  }
</Section>
