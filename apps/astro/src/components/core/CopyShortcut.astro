---
import { Icon } from 'astro-icon/components';
import { profile } from '~/lib/profile';
---

{/*
  Toast lives in the DOM from the start and animates opacity+transform only, so
  it never gates content on script and screen readers announce it politely.
*/}
<div
  id="copy-toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-8 z-50 flex justify-center px-4 opacity-0 transition-[opacity,transform] duration-200 ease-out translate-y-2 data-[visible]:translate-y-0 data-[visible]:opacity-100"
>
  <p
    class="type-body-sm flex items-center gap-1.5 rounded-[8px] bg-inset px-2 py-1.5 text-foreground"
  >
    <Icon name="tabler:check" class="size-4 shrink-0" />
    Copied {profile.email}
  </p>
</div>

<script is:inline define:vars={{ email: profile.email }}>
  (() => {
    let hideTimer;

    const flash = () => {
      const toast = document.getElementById('copy-toast');
      if (!toast) return;

      toast.dataset.visible = '';
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => delete toast.dataset.visible, 2000);

      // The toast is pinned to the bottom of the window, and the shortcut is
      // offered at the top next to the avatar. Anything up there that wants to
      // acknowledge the copy listens for this rather than watching the toast.
      document.dispatchEvent(new CustomEvent('email-copied'));
    };

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'c' && event.key !== 'C') return;
      // Leave the browser's own copy alone, and stay out of the way of typing.
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      const el = document.activeElement;
      if (el instanceof HTMLElement && (el.isContentEditable || /^(input|textarea|select)$/i.test(el.tagName))) {
        return;
      }
      if (window.getSelection()?.toString()) return;

      navigator.clipboard.writeText(email).then(flash, () => {});
    });
  })();
</script>
