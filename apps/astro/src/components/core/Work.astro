---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import WorkGallery from '~/components/react/WorkGallery';

/*
  Four placeholder panels: a white mat with the picture inset — a print in a
  frame rather than a bare screenshot.

  Give a panel an `href` and it becomes a link with the reveal arrow. Until
  then it is deliberately inert — an arrow on a placeholder is a control that
  does nothing.
*/
const panels = [
  { rotate: -9, x: -420, y: 26, z: 10 },
  { rotate: -4, x: -150, y: -18, z: 20 },
  { rotate: 5, x: 130, y: 34, z: 30 },
  { rotate: 11, x: 400, y: -6, z: 20 },
];

/*
  The canvas behind them: contour lines, generated here and emitted as static
  paths. Nothing is computed in the browser — this runs once at build and the
  page ships the finished geometry.

  Contours of a real surface never cross, and that is the whole reason this
  reads as terrain rather than as decoration. Each family shares one angular
  profile and only scales it, so ring `i` is everywhere inside ring `i + 1` by
  construction. The profile is a sum of harmonics in theta, which is periodic
  by definition, so every ring closes on itself exactly rather than nearly.

  Two families, placed so their outermost rings cannot reach each other: 1150
  of combined radius against 1262 of separation. Both centres sit off the
  canvas, so what shows is the shoulder of each rise rather than a pair of
  targets.
*/
const VIEW = { w: 1600, h: 600 };
/*
  Points are spent per unit of arc rather than per ring, so a 700-unit ring is
  not drawn at the same coarseness as a 130-unit one. One point roughly every
  40 units of circumference, floored so the tightest ring still reads as a
  curve and capped so the widest does not pay for detail nobody can see.
*/
const stepsFor = (r: number) =>
  Math.min(104, Math.max(28, Math.round((2 * Math.PI * r) / 40)));

function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** One periodic profile, shared by every ring of a family so none can cross. */
function profile(rand: () => number) {
  const harmonics = [1, 2, 3, 5, 8].map((k) => ({
    k,
    amp: (0.35 + rand() * 0.65) / k,
    phase: rand() * Math.PI * 2,
  }));
  const scale = 1 / harmonics.reduce((sum, h) => sum + h.amp, 0);
  return (t: number) =>
    harmonics.reduce((sum, h) => sum + h.amp * Math.sin(h.k * t + h.phase), 0) *
    scale;
}

function rings(
  cx: number,
  cy: number,
  from: number,
  to: number,
  count: number,
  wobble: number,
  rand: () => number,
) {
  const shape = profile(rand);
  return Array.from({ length: count }, (_, i) => {
    const r = from + ((to - from) * i) / (count - 1);
    const steps = stepsFor(r);
    const points = Array.from({ length: steps }, (_, a) => {
      const t = (a / steps) * Math.PI * 2;
      const rr = r * (1 + wobble * shape(t));
      return `${Math.round(cx + rr * Math.cos(t))} ${Math.round(cy + rr * Math.sin(t))}`;
    });
    return `M${points.join('L')}Z`;
  });
}

const rand = mulberry32(20260905);
const contours = [
  ...rings(300, 640, 130, 700, 11, 0.17, rand),
  ...rings(1350, -70, 110, 450, 8, 0.2, rand),
];
---

<div id="work" class="flex w-full flex-col gap-4">
  <Section gap={24}>
    <div class="flex flex-col gap-4">
      <Overline>Work</Overline>
      <p class="type-body text-muted-foreground">
        Placeholders below. Real project captures are on the way.
      </p>
    </div>
  </Section>

  <div class="relative h-[340px] w-full overflow-hidden tablet:h-[540px]">
    {/* The canvas runs faint — felt, not read. */}
    <svg
      class="work-canvas pointer-events-none absolute inset-0 h-full w-full"
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      {contours.map((d) => <path d={d} />)}
    </svg>

    {/* Hydrates only once the section is close, since none of it means
        anything until there is a pointer over it. */}
    <WorkGallery panels={panels} client:visible />
  </div>
</div>

<style>
  /*
    Hairlines, and hairlines at any size: `non-scaling-stroke` keeps them one
    pixel however far the viewBox is stretched to cover the section. Without it
    a full-bleed canvas draws them thicker on a wide window than a narrow one,
    which is the tell that a background was scaled rather than drawn.
  */
  .work-canvas path {
    fill: none;
    stroke: hsl(var(--muted-foreground) / 0.28);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /*
    A tight, directional cast rather than an all-round bloom, so the panels sit
    on the canvas instead of glowing above it.

    `:global` because the panels are rendered by the island, and Astro scopes a
    component's styles with an attribute the island's own markup never carries.
    The class name is specific enough to leave global.

    The shadow deepens on hover in CSS rather than through the spring: animating
    `box-shadow` repaints every frame while a transform does not, and it is the
    one property here that would rather not be a motion value. Keying it to
    `:hover` also means it still answers on a device that gets no lift.
  */
  :global(.work-panel) {
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.04),
      0 8px 24px rgb(0 0 0 / 0.12);
    transition: box-shadow 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.work-panel:hover) {
    box-shadow:
      0 2px 3px rgb(0 0 0 / 0.06),
      0 18px 44px rgb(0 0 0 / 0.2);
  }

  :global(.dark .work-panel) {
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.3),
      0 12px 32px rgb(0 0 0 / 0.55);
  }

  :global(.dark .work-panel:hover) {
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.4),
      0 22px 56px rgb(0 0 0 / 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.work-panel) {
      transition: none;
    }
  }
</style>
