---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';
import WorkGallery from '~/components/react/WorkGallery';
import { terrainContours } from '~/lib/terrain';

/*
  Four placeholder panels: a white mat with the picture inset — a print in a
  frame rather than a bare screenshot.

  Give a panel an `href` and it becomes a link with the reveal arrow. Until
  then it is deliberately inert — an arrow on a placeholder is a control that
  does nothing.
*/
const panels = [
  { rotate: -9, x: -420, y: 26, z: 10 },
  { rotate: -4, x: -150, y: -18, z: 20 },
  { rotate: 5, x: 130, y: 34, z: 30 },
  { rotate: 11, x: 400, y: -6, z: 20 },
];

/*
  The canvas behind them. Generated at build by `~/lib/terrain`, which is where
  the noise, the grid and the marching-squares walk live — none of that is this
  component's business, and none of it is shipped.

  The frame is wider than it is tall on purpose: the section is full-bleed and
  the SVG covers it, so a landscape field crops to a strip rather than being
  squeezed into one.
*/
const VIEW = { w: 1600, h: 600 };
const contours = terrainContours({
  width: VIEW.w,
  height: VIEW.h,
  seed: 20260906,
});
---

<div id="work" class="flex w-full flex-col gap-4">
  <Section gap={24}>
    <div class="flex flex-col gap-4">
      <Overline>Work</Overline>
      <p class="type-body text-muted-foreground">
        Placeholders below. Real project captures are on the way.
      </p>
    </div>
  </Section>

  <div class="relative h-[340px] w-full overflow-hidden tablet:h-[540px]">
    {/* The canvas runs faint — felt, not read. */}
    <svg
      class="work-canvas pointer-events-none absolute inset-0 h-full w-full"
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      {contours.map((c) => <path d={c.d} class={c.index ? 'index' : undefined} />)}
    </svg>

    {/* Hydrates only once the section is close, since none of it means
        anything until there is a pointer over it. */}
    <WorkGallery panels={panels} client:visible />
  </div>
</div>

<style>
  /*
    Hairlines, and hairlines at any size: `non-scaling-stroke` keeps them one
    pixel however far the viewBox is stretched to cover the section. Without it
    a full-bleed canvas draws them thicker on a wide window than a narrow one,
    which is the tell that a background was scaled rather than drawn.
  */
  .work-canvas path {
    fill: none;
    stroke: hsl(var(--muted-foreground) / 0.2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* The index contour, heavier every fifth level, as a survey draws it. */
  .work-canvas path.index {
    stroke: hsl(var(--muted-foreground) / 0.38);
  }

  /*
    A tight, directional cast rather than an all-round bloom, so the panels sit
    on the canvas instead of glowing above it.

    `:global` because the panels are rendered by the island, and Astro scopes a
    component's styles with an attribute the island's own markup never carries.
    The class name is specific enough to leave global.

    The shadow deepens on hover in CSS rather than through the spring: animating
    `box-shadow` repaints every frame while a transform does not, and it is the
    one property here that would rather not be a motion value. Keying it to
    `:hover` also means it still answers on a device that gets no lift.
  */
  :global(.work-panel) {
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.04),
      0 8px 24px rgb(0 0 0 / 0.12);
    transition: box-shadow 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.work-panel:hover) {
    box-shadow:
      0 2px 3px rgb(0 0 0 / 0.06),
      0 18px 44px rgb(0 0 0 / 0.2);
  }

  :global(.dark .work-panel) {
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.3),
      0 12px 32px rgb(0 0 0 / 0.55);
  }

  :global(.dark .work-panel:hover) {
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.4),
      0 22px 56px rgb(0 0 0 / 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.work-panel) {
      transition: none;
    }
  }
</style>
