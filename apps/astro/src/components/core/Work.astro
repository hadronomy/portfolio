---
import { terrainContours } from '~/lib/terrain';
import WorkGallery from '~/components/react/WorkGallery';
import { projects } from '~/lib/work-projects';
const contours = terrainContours({ width: 1600, height: 800, seed: 20260906 });
---

<section id="work" aria-label="Selected work">
  <WorkGallery {projects} client:load>
    <svg
      slot="terrain"
      class="work-terrain"
      viewBox="0 0 1600 800"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      {contours.map((contour) => <path d={contour.d} data-index={contour.index} />)}
    </svg>
  </WorkGallery>
  <noscript>
    <ul class="mx-auto max-w-content px-4">
      {
        projects.map((project) => (
          <li>
            <a href={project.href}>{project.title} ↗</a>
          </li>
        ))
      }
    </ul>
  </noscript>
</section>
