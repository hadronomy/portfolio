---
import Overline from '~/components/core/Overline.astro';
import Section from '~/components/core/Section.astro';

/*
  Four placeholder frames at Core's geometry (184x248, 10px radius, alternating
  tilt). Real photographs replace the inner div and nothing else moves.

  Core also puts a Spotify now-playing card above this strip. That needs a live
  integration, so it lands in a later layer rather than as a static mock of
  something that is meant to be current.
*/
const frames = [-4, 2, -2, 5];
---

<Section id="personal">
  <Overline>Personal</Overline>

  <p class="type-body text-muted-foreground">
    Away from the keyboard I take photographs.
  </p>

  {/* Vertical padding clears the tallest tilted corner so no frame is cut. */}
  <div class="py-4">
    <ul class="flex items-center gap-3">
      {
        frames.map((rotate) => (
          <li
            class="h-[248px] min-w-0 flex-1 rounded-[10px] border border-subtle bg-inset"
            style={`transform: rotate(${rotate}deg);`}
          >
            <span class="type-overline flex h-full items-center justify-center text-muted-foreground/40">
              —
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
