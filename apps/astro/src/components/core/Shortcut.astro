---
interface Props {
  /** The key as the visitor sees it on their keyboard. */
  key: string;
}

const { key } = Astro.props;
---

{/*
  The shadow is a real offset cast rather than a second element, and it is
  dropped entirely in dark mode — Core sets the token to zero alpha there
  rather than darkening it, which is why this is one token and not two rules.
*/}
{/*
  Exactly 18px tall with no vertical padding, as Core sets it — any extra
  height pushes the whole line and shows up as a spacing drift below.

  fumadocs-ui's preset styles every `kbd` as a chunky dark keycap: a gradient
  fill, a 3px bottom border and a text shadow. Those win in light mode and clip
  the glyph, so each one is reset explicitly rather than left to cascade order.
*/}
<kbd
  class="shortcut-key inline-flex h-[18px] min-w-[20px] items-center justify-center rounded-[6px] bg-shortcut px-1.5 font-sans text-[13px] leading-[18px] font-medium text-foreground"
>
  {key}
</kbd>

<style>
  .shortcut-key {
    border: 0;
    background-image: none;
    text-shadow: none;
    box-shadow: 0 1px 0 0 hsl(var(--shortcut-shadow));
  }
</style>
