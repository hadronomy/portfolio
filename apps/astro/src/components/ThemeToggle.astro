---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {}

const { class: className, ...props } = Astro.props;
---

{/*
  Both icons are rendered and one is hidden by the `.dark` class rather than
  swapped in script, so the correct glyph is painted on first frame and the
  button never flashes the wrong state during hydration.
*/}
<button
  id="theme-toggle"
  type="button"
  class:list={[
    'group relative flex h-9 w-9 items-center justify-center rounded-[var(--radius)] border border-border bg-button transition-colors hover:bg-button-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
    className,
  ]}
  aria-label="Switch between light and dark theme"
  {...props}
>
  <Icon name="tabler:sun" class="h-4 w-4 text-foreground dark:hidden" />
  <Icon name="tabler:moon" class="hidden h-4 w-4 text-foreground dark:block" />
</button>

<script>
  type Theme = 'light' | 'dark';

  const STORAGE_KEY = 'theme';

  const apply = (theme: Theme) => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.style.colorScheme = theme;
  };

  const current = (): Theme =>
    document.documentElement.classList.contains('dark') ? 'dark' : 'light';

  // Delegated from document so a view transition swapping the button in does
  // not stack a second listener on it — that would toggle twice per click.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('#theme-toggle')) return;

    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    localStorage.setItem(STORAGE_KEY, next);
    apply(next);
  });

  // Only follow the OS while the visitor has not made an explicit choice.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', (event) => {
      if (localStorage.getItem(STORAGE_KEY)) return;
      apply(event.matches ? 'dark' : 'light');
    });
</script>
