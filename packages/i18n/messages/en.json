{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "date_long": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime dateStyle=long timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "date_document": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime day=numeric month=short year=numeric timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "date_short": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime day=numeric month=short timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "percent": [
    {
      "declarations": [
        "input value",
        "local p = value: number maximumFractionDigits=2"
      ],
      "selectors": [],
      "match": {
        "*": "{p}%"
      }
    }
  ],
  "span": [
    {
      "declarations": [
        "input count",
        "input unit",
        "local countPlural = count: plural"
      ],
      "selectors": ["unit", "countPlural"],
      "match": {
        "unit=day, countPlural=one": "{count} day",
        "unit=day, countPlural=*": "{count} days",
        "unit=week, countPlural=one": "{count} week",
        "unit=week, countPlural=*": "{count} weeks",
        "unit=month, countPlural=one": "{count} month",
        "unit=month, countPlural=*": "{count} months",
        "unit=*, countPlural=*": "{count}"
      }
    }
  ],
  "doc_kind": [
    {
      "declarations": ["input kind"],
      "selectors": ["kind"],
      "match": {
        "kind=invoice": "Invoice",
        "kind=rectification": "Rectifying invoice",
        "kind=quote": "Quote",
        "kind=*": "Invoice"
      }
    }
  ],
  "doc_draft": "Draft · Not issued",
