    {
      "declarations": [
        "input treatment",
        "input rate",
        "local r = rate: number maximumFractionDigits=2"
      ],
      "selectors": ["treatment"],
      "match": {
        "treatment=taxable": "IGIC {r}%",
        "treatment=exempt": "Exempt",
        "treatment=outside-scope": "Outside scope",
        "treatment=reverse-charge": "Reverse charge",
        "treatment=*": ""
      }
    }
