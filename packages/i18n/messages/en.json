  "notice_validity_title": "Validity",
  "notice_validity": [
    {
      "declarations": [
        "input until",
        "local day = until: datetime day=numeric month=short year=numeric timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "This quote is valid until {day}. Once accepted, it binds both parties on its terms. It is not an invoice: each payment is invoiced when it falls due."
      }
    }
  ],
  "notice_price_title": "Price",
  "notice_price": "The total price includes IGIC and every other applicable tax.",
  "notice_acceptance_title": "How to accept",
  "notice_acceptance": [
    {
      "declarations": ["input issuer", "input language"],
      "selectors": [],
      "match": {
        "*": "The customer opens the quote's link, reads it, types their full name, draws their signature, and accepts it. That acceptance is their electronic signature. {issuer} keeps the accepted document and emails a copy within 24 hours. Before accepting, the customer can ask for a revised quote to correct anything. The contract is concluded in {language}."
      }
    }
  ],
  "notice_contract_language": [
    {
      "declarations": ["input language"],
      "selectors": ["language"],
      "match": {
        "language=en": "English",
        "language=es": "Spanish",
        "language=*": ""
      }
    }
  ],
  "notice_withdrawal_title": "Right of withdrawal",
  "notice_withdrawal": [
    {
      "declarations": ["input email"],
      "selectors": [],
      "match": {
        "*": "The customer can withdraw from the contract within 14 calendar days of the day they accept the quote, without giving any reason and at no cost. To do so, they only need to say so clearly to {email}, for example with the form at the end of this document. Work does not start within that period unless the customer expressly asks for it when accepting. In that case, if they then withdraw, they pay for the part already done in proportion to the total price, and they lose the right once the work is fully done."
      }
    }
  ],
  "notice_complaints_title": "Customer service",
  "notice_complaints": [
    {
      "declarations": ["input email"],
      "selectors": [],
      "match": {
        "*": "Complaints are handled at {email}, with an answer within one month. Official complaint forms are available to the customer."
      }
    }
  ],
  "notice_privacy_title": "Data protection",
  "notice_privacy": [
    {
      "declarations": ["input controller", "input email"],
      "selectors": [],
      "match": {
        "*": "{controller} processes the customer's data to prepare this quote and, if it is accepted, to perform the contract. It keeps the data for the length of the relationship and the periods the law sets. The customer can ask for access, rectification, erasure, restriction, or portability of their data, or object to its processing, at {email}, and can complain to the Spanish Data Protection Agency (aepd.es)."
      }
    }
  ],
  "withdrawal_lede": "Complete and return it only if you wish to withdraw from the contract.",
  "withdrawal_to": "To",
  "withdrawal_notice_label": "Notice",
