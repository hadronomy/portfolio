{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "date_long": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime dateStyle=long timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "date_document": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime day=numeric month=short year=numeric timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "date_short": [
    {
      "declarations": [
        "input date",
        "local d = date: datetime day=numeric month=short timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "{d}"
      }
    }
  ],
  "percent": [
    {
      "declarations": [
        "input value",
        "local p = value: number maximumFractionDigits=2"
      ],
      "selectors": [],
      "match": {
        "*": "{p} %"
      }
    }
  ],
  "span": [
    {
      "declarations": [
        "input count",
        "input unit",
        "local countPlural = count: plural"
      ],
      "selectors": ["unit", "countPlural"],
      "match": {
        "unit=day, countPlural=one": "{count} día",
        "unit=day, countPlural=*": "{count} días",
        "unit=week, countPlural=one": "{count} semana",
        "unit=week, countPlural=*": "{count} semanas",
        "unit=month, countPlural=one": "{count} mes",
        "unit=month, countPlural=*": "{count} meses",
        "unit=*, countPlural=*": "{count}"
      }
    }
  ],
  "doc_kind": [
    {
      "declarations": ["input kind"],
      "selectors": ["kind"],
      "match": {
        "kind=invoice": "Factura",
        "kind=rectification": "Factura rectificativa",
        "kind=quote": "Presupuesto",
        "kind=*": "Factura"
      }
    }
