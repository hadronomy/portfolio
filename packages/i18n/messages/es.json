  "notice_validity_title": "Validez",
  "notice_validity": [
    {
      "declarations": [
        "input until",
        "local day = until: datetime day=numeric month=short year=numeric timeZone=UTC"
      ],
      "selectors": [],
      "match": {
        "*": "Este presupuesto es válido hasta el {day}. Una vez aceptado, sus condiciones obligan a ambas partes. No es una factura: cada pago se factura en su fecha de vencimiento."
      }
    }
  ],
  "notice_price_title": "Precio",
  "notice_price": "El precio total incluye el IGIC y todos los demás impuestos aplicables.",
  "notice_acceptance_title": "Cómo se acepta",
  "notice_acceptance": [
    {
      "declarations": ["input issuer", "input language"],
      "selectors": [],
      "match": {
        "*": "El cliente abre el enlace del presupuesto, lo lee, introduce su nombre completo, traza su firma y lo acepta. Esta aceptación constituye su firma electrónica. {issuer} conserva el documento aceptado y envía una copia por correo electrónico en las 24 horas siguientes. Antes de aceptar, el cliente puede solicitar un presupuesto revisado para corregir cualquier error. El contrato se formaliza en {language}."
      }
    }
  ],
  "notice_contract_language": [
    {
      "declarations": ["input language"],
      "selectors": ["language"],
      "match": {
        "language=en": "inglés",
        "language=es": "español",
        "language=*": ""
      }
    }
  ],
  "notice_withdrawal_title": "Derecho de desistimiento",
  "notice_withdrawal": [
    {
      "declarations": ["input email"],
      "selectors": [],
      "match": {
        "*": "El cliente puede desistir del contrato en un plazo de 14 días naturales desde el día en que acepta el presupuesto. No necesita justificar su decisión. El desistimiento no tiene coste, salvo el supuesto de inicio anticipado indicado a continuación. Basta con comunicar su decisión de forma inequívoca a {email}, por ejemplo, mediante el formulario al final de este documento. El trabajo no comienza durante el plazo de desistimiento, salvo que el cliente lo solicite expresamente al aceptar. Si solicita el inicio anticipado y después desiste, debe abonar la parte del servicio ya prestada en proporción al precio total. En este supuesto, pierde el derecho de desistimiento cuando el servicio se haya prestado por completo."
      }
    }
  ],
  "notice_complaints_title": "Atención a la clientela",
  "notice_complaints": [
    {
      "declarations": ["input email"],
      "selectors": [],
      "match": {
        "*": "Las quejas y reclamaciones se atienden en {email}. Se responde en un plazo máximo de un mes. El cliente tiene a su disposición hojas de reclamaciones oficiales."
      }
    }
  ],
  "notice_privacy_title": "Protección de datos",
  "notice_privacy": [
    {
      "declarations": ["input controller", "input email"],
      "selectors": [],
      "match": {
        "*": "{controller} trata los datos del cliente para preparar este presupuesto y, si se acepta, para cumplir el contrato. Los conserva mientras dure la relación con el cliente y durante los plazos que establece la ley. El cliente puede ejercer los derechos de acceso, rectificación, supresión, limitación del tratamiento, portabilidad y oposición a través de {email}. También puede presentar una reclamación ante la Agencia Española de Protección de Datos (aepd.es)."
      }
    }
  ],
  "withdrawal_lede": "(sólo debe cumplimentar y enviar el presente formulario si desea desistir del contrato)",
  "withdrawal_to": "A la atención de",
  "withdrawal_notice_label": "Comunicación",
