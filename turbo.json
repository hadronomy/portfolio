{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*.local", "patches/**"],
  "globalEnv": ["NODE_ENV", "VERCEL_URL", "PORT", "GITHUB_TOKEN", "VERCEL"],
  "ui": "tui",
  "globalPassThroughEnv": ["COREPACK_HOME"],
  "tasks": {
    "start": {
      "dependsOn": ["^start", "build"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".astro/**", "dist/**", ".vercel/output/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "@portfolio/astro#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/start/src/**",
        "$TURBO_ROOT$/apps/start/package.json",
        "$TURBO_ROOT$/apps/start/vite.config.ts",
        "$TURBO_ROOT$/apps/start/tsconfig.json",
        "$TURBO_ROOT$/packages/site-routing/src/**",
        "$TURBO_ROOT$/packages/invoices/**",
        "!$TURBO_ROOT$/packages/invoices/node_modules/**",
        "!$TURBO_ROOT$/apps/start/src/astro-routes.gen.json",
        "!$TURBO_ROOT$/apps/start/src/routeTree.gen.ts"
      ],
      "dependsOn": ["^build"],
      "outputs": [
        ".astro/**",
        "dist/**",
        ".vercel/output/**",
        "$TURBO_ROOT$/apps/start/dist/**",
        "$TURBO_ROOT$/apps/start/src/astro-routes.gen.json",
        "$TURBO_ROOT$/apps/start/src/routeTree.gen.ts"
      ]
    }
  }
}
