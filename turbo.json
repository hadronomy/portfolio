{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*.local", "patches/**"],
  "globalEnv": ["NODE_ENV", "VERCEL_URL", "PORT", "GITHUB_TOKEN", "VERCEL"],
  "ui": "tui",
  "globalPassThroughEnv": ["COREPACK_HOME"],
  "tasks": {
    "start": {
      "dependsOn": ["^start", "build"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".astro/**", "dist/**", ".vercel/output/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "@portfolio/astro#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/start/**",
        "!$TURBO_ROOT$/apps/start/node_modules/**",
        "!$TURBO_ROOT$/apps/start/dist/**",
        "!$TURBO_ROOT$/apps/start/.invoice-data/**",
        "!$TURBO_ROOT$/apps/start/src/astro-routes.gen.json",
        "!$TURBO_ROOT$/apps/start/src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/i18n/src/paraglide/**",
        "$TURBO_ROOT$/tooling/**",
        "!$TURBO_ROOT$/tooling/*/node_modules/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock"
      ],
      "dependsOn": ["^build"],
      "outputs": [
        ".astro/**",
        "dist/**",
        ".vercel/output/**",
        "$TURBO_ROOT$/apps/start/dist/**",
        "$TURBO_ROOT$/apps/start/src/astro-routes.gen.json",
        "$TURBO_ROOT$/apps/start/src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/i18n/src/paraglide/**"
      ],
      "env": [
        "CERTIFICATE_P12",
        "CERTIFICATE_PASSWORD",
        "VERCEL_ENV",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_SKEW_PROTECTION_ENABLED",
        "INVOICE_*",
        "DATABASE_URL",
        "RESEND_API_KEY",
        "STRIPE_*",
        "BETTER_AUTH_*",
        "AUTH_SECRET"
      ]
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:check": {
      "cache": false
    },
    "@portfolio/i18n#build": {
      "inputs": ["$TURBO_DEFAULT$", "!src/paraglide/**"],
      "outputs": ["src/paraglide/**"]
    }
  }
}
