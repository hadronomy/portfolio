{
  "name": "@hadronomy/portfolio",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.2",
  "scripts": {
    "prepare": "husky",
    "format": "bun biome format --write .; bun prettier --write .",
    "lint": "bun biome lint --apply .",
    "lint:ws": "bunx sherif@latest",
    "ci": "node scripts/deploy/ci.mjs",
    "build:vercel": "node scripts/deploy/vercel-build.mjs",
    "update:plan": "bun taze",
    "update:write": "bun taze --write",
    "dev": "bun run --cwd apps/astro dev",
    "dev:stop": "bun run --cwd apps/astro astro dev stop",
    "build": "turbo run build --filter=@portfolio/astro",
    "db:generate": "bun run --cwd packages/invoices db:generate && bun run --cwd apps/start db:generate",
    "db:migrate": "bun run --cwd packages/invoices db:migrate && bun run --cwd apps/start db:migrate",
    "db:check": "bun run --cwd packages/invoices db:check && bun run --cwd apps/start db:check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:lint",
    "@commitlint/cli": "catalog:lint",
    "@commitlint/config-conventional": "catalog:lint",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "prettier": "catalog:lint",
    "prettier-plugin-astro": "catalog:lint",
    "taze": "catalog:cli",
    "turbo": "catalog:monorepo"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "bun biome check --write --no-errors-on-unmatched"
    ]
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalogs": {
      "build": {
        "@rollup/plugin-typescript": "12.3.0",
        "@tailwindcss/vite": "^4.1.18",
        "rollup-preserve-directives": "^1.1.3"
      },
      "cli": {
        "taze": "^19.9.2"
      },
      "dev": {
        "@astrojs/language-server": "^2.16.2",
        "@swc-node/register": "^1.11.1",
        "@swc/core": "^1.15.7",
        "@swc/helpers": "^0.5.17",
        "fdir": "6.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "ts-node": "10.9.2",
        "tslib": "2.8.1",
        "typescript": "5.9.3"
      },
      "icons": {
        "@iconify-json/logos": "^1.2.10",
        "@iconify-json/material-icon-theme": "^1.2.44",
        "@iconify-json/simple-icons": "^1.2.63",
        "@iconify-json/tabler": "^1.2.24",
        "astro-icon": "1.1.5",
        "iconoir-react": "^7.11.0",
        "lucide-react": "0.562.0",
        "react-icons": "5.5.0"
      },
      "lint": {
        "@biomejs/biome": "^2.3.10",
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "20.2.0",
        "prettier": "^3.7.4",
        "prettier-plugin-astro": "0.14.1"
      },
      "monorepo": {
        "turbo": "2.7.0"
      },
      "prod": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/mdx": "^8.0.0",
        "@astrojs/react": "^6.0.5",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@nextui-org/button": "2.2.9",
        "@radix-ui/react-avatar": "1.1.11",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tooltip": "^1.2.8",
        "astro": "^7.3.1",
        "motion": "^12.23.26",
        "fumadocs-core": "^16.3.1",
        "fumadocs-ui": "^16.3.1",
        "katex": "^0.16.27",
        "react": "^19.1.4",
        "react-dom": "^19.1.4",
        "rehype-accessible-emojis": "0.3.2",
        "rehype-katex": "^7.0.1",
        "remark-gemoji": "8.0.0",
        "remark-math": "^6.0.0",
        "sharp": "0.34.5",
        "sharp-ico": "^0.1.5",
        "tailwind-variants": "3.2.2",
        "takumi-pdf": "0.14.3",
        "takumi-js": "2.13.6",
        "@vgpu/wgsl": "0.5.0",
        "vgpu": "^0.5.0"
      },
      "style": {
        "@tailwindcss/postcss": "^4.1.18",
        "autoprefixer": "10.4.23",
        "postcss": "8.5.6",
        "tailwind-merge": "3.4.0",
        "tailwindcss": "4.1.18",
        "tailwindcss-animate": "1.0.7"
      },
      "syntax": {
        "@shikijs/twoslash": "^3.20.0"
      },
      "test": {
        "vitest": "5.0.2"
      },
      "types": {
        "@types/node": "25.0.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@webgpu/types": "^0.1.69"
      },
      "utils": {
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1"
      }
    }
  },
  "patchedDependencies": {
    "@tanstack/router-generator@1.167.34": "patches/@tanstack%2Frouter-generator@1.167.34.patch"
  }
}
